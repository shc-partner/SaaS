{
    "name": "siteforge/platform-backend",
    "description": "SiteForge platform API — plain PHP, PSR-4 autoload only.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "SiteForge\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
