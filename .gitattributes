# 모든 텍스트 파일: git 저장소에는 LF로 저장
* text=auto eol=lf

# 백엔드 PHP — 명시적 LF 강제
platform-backend/**/*.php  text eol=lf
platform-backend/**/*.sql  text eol=lf
platform-backend/**/*.json text eol=lf
platform-backend/**/*.md   text eol=lf

# 프론트엔드
platform-frontend/**/*.ts   text eol=lf
platform-frontend/**/*.tsx  text eol=lf
platform-frontend/**/*.css  text eol=lf
platform-frontend/**/*.json text eol=lf
platform-frontend/**/*.html text eol=lf

# 설정 파일
*.yml  text eol=lf
*.yaml text eol=lf
*.env  text eol=lf
*.sh   text eol=lf

# 바이너리 — 절대 변환 안 함
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
