{
  "// NOTE": "이 파일은 IDE 전용 — 실제 빌드는 platform-frontend 의 tsconfig.app.json 이 포함 경로로 컴파일한다.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../../platform-frontend/node_modules/@types/react"],
      "react/*": ["../../platform-frontend/node_modules/@types/react/*"]
    },
    "typeRoots": [
      "../../platform-frontend/node_modules/@types"
    ]
  },
  "include": ["src"]
}
